2. **Middleware de Logging (middlewares/logger.js):** Registra tempo de resposta, método HTTP e status.
Crie o arquivo `middlewares/logger.js` para registrar a data/hora, o método HTTP, a URL acessada, o status HTTP retornado e o tempo total de processamento em milissegundos.

```javascript
const loggerMiddleware = (req, res, next) => {
    const inicio = Date.now();
    const timestamp = new Date().toISOString();

    res.on('finish', () => {
        const duracao = Date.now() - inicio;
        console.log(`[LOG ${timestamp}] ${req.method} ${req.originalUrl} - Status: ${res.statusCode} (${duracao}ms)`);
    });

    next();
};

module.exports = loggerMiddleware;

```


3. **Middleware de Autenticação (middlewares/auth.js):** Validação do header X-API-KEY.
Crie o arquivo `middlewares/auth.js` para proteger as rotas restritas através do cabeçalho HTTP personalizado.

```javascript
function authMiddleware(req, res, next) {
    const apiKey = req.headers['x-api-key'];
    const CHAVE_VALIDA = "binario-tech-secret-2026";

    if (!apiKey || apiKey !== CHAVE_VALIDA) {
        return res.status(401).json({
            erro: "Acesso nao autorizado. Header 'X-API-KEY' invalido ou ausente."
        });
    }

    next();
}

module.exports = authMiddleware;

```


4. **Middleware de Validação de CNH (middlewares/validaCnh.js):** Validação de payload com exatamente 11 dígitos numéricos.
Crie o arquivo `middlewares/validaCnh.js` para garantir a integridade dos dados enviados no cadastro de motoristas.

```javascript
function validaCnhMiddleware(req, res, next) {
    const { cnh } = req.body;
    const cnhValida = /^\d{11}$/.test(cnh);

    if (!cnh || !cnhValida) {
        return res.status(400).json({
            erro: "Validação falhou. O campo 'cnh' deve conter exatamente 11 dígitos numéricos."
        });
    }

    next();
}

module.exports = validaCnhMiddleware;

```


5. **Módulo de Rotas de Motoristas (routes/motoristas.js):** Gerenciamento de motoristas usando express.Router().
Crie o arquivo `routes/motoristas.js` contendo a base de dados em memória e as rotas GET e POST.

```javascript
const express = require('express');
const router = express.Router();

let motoristas = [
    { id: 1, nome: "Carlos Silva", cnh: "12345678900", categoria: "E", ativo: true },
    { id: 2, nome: "Ana Pereira", cnh: "98765432100", categoria: "D", ativo: true }
];

// GET /api/v1/motoristas
router.get('/', (req, res) => {
    res.status(200).json(motoristas);
});

// POST /api/v1/motoristas
router.post('/', (req, res) => {
    const { nome, cnh, categoria } = req.body;

    if (!nome || !cnh || !categoria) {
        return res.status(400).json({ 
            erro: "Campos 'nome', 'cnh' e 'categoria' sao obrigatorios." 
        });
    }

    const novoMotorista = {
        id: motoristas.length + 1,
        nome,
        cnh,
        categoria,
        ativo: true
    };

    motoristas.push(novoMotorista);
    res.status(201).json(novoMotorista);
});

module.exports = router;

```


